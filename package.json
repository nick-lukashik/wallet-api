{
    "name": "wallet-api",
    "version": "0.1.0",
    "private": true,
    "description": "NestJS service starter: Postgres + Drizzle, Redis, RabbitMQ outbox/inbox, pg-boss",
    "type": "module",
    "packageManager": "pnpm@12.16.1",
    "engines": {
        "node": ">=26.13.0",
        "pnpm": ">=12.16.1"
    },
    "scripts": {
        "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
        "build": "pnpm clean && tsc -p tsconfig.build.json",
        "start": "node --env-file-if-exists=.env dist/main.js",
        "dev": "pnpm build && pnpm run \"/^dev:/\"",
        "dev:tsc": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
        "dev:node": "node --env-file-if-exists=.env --watch-path=dist dist/main.js",
        "typecheck": "tsc --noEmit",
        "lint": "biome check .",
        "format": "biome check --write .",
        "test": "vitest run",
        "test:unit": "vitest run --project unit",
        "test:int": "vitest run --project integration",
        "verify": "pnpm lint && pnpm typecheck && pnpm build && pnpm test",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "pnpm build && node --env-file-if-exists=.env dist/db/migrate.js",
        "messaging:replay-dlq": "pnpm build && node --env-file-if-exists=.env dist/messaging/replay-dlq.js",
        "infra:up": "docker compose up -d --wait",
        "infra:down": "docker compose down",
        "infra:reset": "docker compose down --volumes",
        "env:local": "node -e \"fs.existsSync('.env')?console.log('.env already exists'):(fs.copyFileSync('.env.example','.env',fs.constants.COPYFILE_EXCL),console.log('created .env: fill INTERNAL_API_TOKEN'))\""
    },
    "dependencies": {
        "@nestjs/common": "12.3.2",
        "@nestjs/config": "12.0.1",
        "@nestjs/core": "12.3.2",
        "@nestjs/platform-express": "12.3.2",
        "@nestjs/swagger": "12.0.5",
        "@nestjs/terminus": "12.1.0",
        "@nick-lukashik/auth": "0.1.0",
        "@nick-lukashik/contracts": "0.1.0",
        "@prometheus-io/client": "0.16.1",
        "amqplib": "2.2.0",
        "drizzle-orm": "0.45.4",
        "nestjs-pino": "5.3.1",
        "pg": "8.23.1",
        "pino": "10.4.0",
        "pino-http": "11.0.0",
        "reflect-metadata": "0.2.2",
        "rxjs": "7.8.2",
        "zod": "4.6.7"
    },
    "devDependencies": {
        "@biomejs/biome": "2.6.4",
        "@nestjs/testing": "12.3.2",
        "@standard-schema/spec": "1.1.0",
        "@swc/core": "1.16.21",
        "@testcontainers/postgresql": "12.2.1",
        "@testcontainers/rabbitmq": "12.2.1",
        "@testcontainers/redis": "12.2.1",
        "@types/express": "5.0.6",
        "@types/node": "26.6.6",
        "@types/pg": "8.23.1",
        "@types/supertest": "7.2.1",
        "drizzle-kit": "0.31.11",
        "jose": "6.2.14",
        "supertest": "7.3.1",
        "testcontainers": "12.2.1",
        "typescript": "7.0.2",
        "unplugin-swc": "2.0.0",
        "vitest": "5.0.5"
    }
}
