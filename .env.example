# Copy to .env with `pnpm env:local`. In Kubernetes: ConfigMap wallet-api-config and
# SealedSecret wallet-api-secrets (envFrom).
NODE_ENV=development
PORT=4300
LOG_LEVEL=info
APP_VERSION=dev
METRICS_PORT=9473
TRUST_PROXY_HOPS=0
SHUTDOWN_DELAY_MS=0

DATABASE_URL=postgres://app:app@localhost:5443/app
DATABASE_POOL_MAX=10
RABBITMQ_URL=amqp://app:app@localhost:5683

ID_JWKS_URL=http://localhost:4100/.well-known/jwks.json
TOKEN_ISSUER=http://localhost:3100
TOKEN_AUDIENCE=nick-lukashik
WALLET_ADMIN_MAX_AMOUNT=1000000

# Secret, never committed: the token other services use to call /internal.
INTERNAL_API_TOKEN=
